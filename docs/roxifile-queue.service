[Unit]
Description=RoxiFile Horizon queue manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/roxifile
ExecStart=/usr/bin/php artisan horizon --no-interaction
Restart=always
RestartSec=5
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=120
UMask=0077

[Install]
WantedBy=multi-user.target
