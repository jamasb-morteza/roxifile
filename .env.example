APP_NAME=RoxiFile
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://roxifile.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=roxifile
DB_USERNAME=
DB_PASSWORD=

TELEGRAM_DB_HOST=127.0.0.1
TELEGRAM_DB_PORT=5432
TELEGRAM_DB_DATABASE=
TELEGRAM_DB_USERNAME=
TELEGRAM_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=roxifile.example.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https


TELEGRAM_APP_ID="YOUR TELEGRAM APP ID"
TELEGRAM_API_HASH="YOUR API HASH"
TELEGRAM_ROXI_USERNAME=roxi_main_connection_usrname_sample

MTPROTO_SERVER_ADDRESS=
MTPROTO_SERVER_DC="DC 2"
MTPROTO_PUBLIC_KEY="-----BEGIN RSA PUBLIC KEY-----
YOUR MTPROTO PUBLIC KEY
-----END RSA PUBLIC KEY-----"

TELEGRAM_TEST_ACCOUNT_USERNAME=@sample_username

OCTANE_SERVER=frankenphp
OCTANE_HOST=0.0.0.0
OCTANE_PORT=8001

OCTANE_HTTPS=true


ELEVENLABS_API_KEY=sk_EXAMPLE_API_KEY
ELEVENLABS_VOICE_ID=
AI_TTS_API_TOKEN=
AI_TTS_MODEL=eleven_v3


GOOGLE_CLIENT_ID=example_client_id_pulhq.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-EXAMPLE
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
TELEGRAM_MAX_UPLOAD_KIB=204800
